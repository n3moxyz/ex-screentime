{
  "name": "ralph-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "node scripts/validate-fixture.mjs && node scripts/validate-scoring.mjs",
    "test:reducer": "node scripts/reducer-unit.mjs",
    "test:local-inspect": "node scripts/local-inspect-unit.mjs",
    "test:report": "node scripts/report-unit.mjs",
    "smoke:visual": "node scripts/visual-smoke.mjs",
    "check": "npm run validate && npm run test:reducer && npm run test:local-inspect && npm run test:report && npm run typecheck && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright-core": "^1.60.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.13"
  }
}
